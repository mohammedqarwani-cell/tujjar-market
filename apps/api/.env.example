NODE_ENV=production
# Pooled connection for the running API
DATABASE_URL="postgresql://USER:PASSWORD@db-host:5432/tujjar_db?schema=public"
# Direct (session) connection for migrations; the same URL when there is no pooler
DIRECT_URL="postgresql://USER:PASSWORD@db-host:5432/tujjar_db?schema=public"
PORT=4000
# Reverse proxies in front of the API (1 behind nginx/Cloudflare, 2 behind a Vercel proxy on Render)
TRUST_PROXY=1

# One origin (or comma-separated list) per interface
WEB_ORIGIN=https://tujjar.sy
MERCHANT_ORIGIN=https://merchant.tujjar.sy
ADMIN_ORIGIN=https://admin.tujjar.sy
# Parent domain so cookies reach the API subdomain
COOKIE_DOMAIN=.tujjar.sy
COOKIE_SECURE=true
# Only when each frontend proxies the API under a path, e.g. /api
COOKIE_PATH_PREFIX=

# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
OTP_PEPPER=
# 32 bytes base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOTP_ENC_KEY=
# Encrypts merchant identity documents and shop videos (32 bytes base64, same command as above)
KYC_ENC_KEY=

# Required in production; the dev console sender is refused
SMS_PROVIDER=
TERMS_VERSION=2026-09
# Public demo only: allows running without SMS and shows codes on screen (with OTP_DEV_ECHO=true). Never for launch.
DEMO_MODE=false
OTP_DEV_ECHO=false

MINIO_ENDPOINT=http://localhost:9000
# S3 region (MinIO ignores it; Supabase Storage needs the project region)
MINIO_REGION=us-east-1
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=public
# Private bucket for verification evidence; never give it a public policy
MINIO_PRIVATE_BUCKET=kyc
MEDIA_PUBLIC_URL=https://media.tujjar.sy/public

# Passwords for the seeded demo accounts; required when seeding with NODE_ENV=production
SEED_ADMIN_PASSWORD=
SEED_MERCHANT_PASSWORD=
SEED_BUYER_PASSWORD=
