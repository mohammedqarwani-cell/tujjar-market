generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  /// Pooled connection used by the running API (Supabase transaction pooler in the demo)
  url       = env("DATABASE_URL")
  /// Direct session connection used by migrations; the same URL locally
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  MODERATOR
  FIELD_AGENT
  MERCHANT
  BUYER
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum OtpPurpose {
  REGISTER
  RESET_PASSWORD
  /// Confirms a new number before it replaces the account's phone
  CHANGE_PHONE
}

enum StoreStatus {
  ACTIVE
  SUSPENDED
}

enum GovernorateStatus {
  /// Merchants can register and stores are public
  ACTIVE
  /// Shown as "coming soon"; merchants can only register interest
  COMING_SOON
}

enum GeofenceStatus {
  /// Approximate boundary: distances guide reviewers but never block a merchant
  DRAFT
  /// Surveyed boundary: shop videos recorded outside it are refused
  CONFIRMED
}

/// Tiered, risk-based verification. The order matters: higher levels sort first.
enum VerificationLevel {
  /// Phone and WhatsApp verified by SMS, terms accepted, information attested
  REGISTERED
  /// Owner identity document and selfie reviewed
  IDENTITY
  /// In-app shop video with GPS inside the chosen market reviewed
  LOCATION
  /// Shop visited by a field agent
  PREMIUM
}

enum VerificationKind {
  IDENTITY
  LOCATION
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum GeoCheck {
  INSIDE
  OUTSIDE
  NO_GEOFENCE
}

enum ProductStatus {
  ACTIVE
  UNDER_REVIEW
  HIDDEN
}

enum PriceType {
  FIXED
  NEGOTIABLE
  ON_REQUEST
}

enum Currency {
  SYP
  USD
}

enum ItemCondition {
  NEW
  USED
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

enum ReviewStatus {
  PUBLISHED
  /// Held automatically (links, phone numbers, prohibited goods) until a moderator decides
  UNDER_REVIEW
  HIDDEN
}

/// What a notification is about; users choose per category where it reaches them
enum NotificationCategory {
  /// The user's own account, store, reviews and reports (always shown in the app)
  ACCOUNT
  /// New reviews on the merchant's store
  REVIEWS
  /// Price drops and restocks on the buyer's favorite products
  FAVORITES
  /// New products and offers from stores the buyer follows
  FOLLOWING
  /// Platform news, offers and seasonal campaigns
  PROMOTIONS
  /// Invitations: review a store you contacted, verify your store, try a new feature
  INVITES
  /// Moderation queues (verification, reports, held reviews) for staff
  MODERATION
  /// Buyer requests waiting for the merchant to answer
  ORDERS
}

/// Where a purchase order stands with the shop
enum OrderStatus {
  /// Waiting for the shop to confirm price, delivery fee and time
  NEW
  CONFIRMED
  DONE
  CANCELLED
}

/// Delivery to the buyer, or the buyer picks it up from the shop
enum Fulfillment {
  DELIVERY
  PICKUP
}

/// Money is settled between buyer and shop; the platform takes nothing
enum PaymentMethod {
  CASH_ON_DELIVERY
  CASH_AT_SHOP
  TRANSFER
}

enum CampaignAudience {
  BUYERS
  MERCHANTS
  /// Merchants whose store is still at the REGISTERED level
  MERCHANTS_UNVERIFIED
  ALL
}

enum CampaignStatus {
  SENDING
  SENT
  FAILED
}

model User {
  id                    String                @id @default(cuid())
  name                  String
  /// E.164 without the plus sign, e.g. 963912345678
  phone                 String                @unique
  passwordHash          String
  role                  Role                  @default(BUYER)
  status                UserStatus            @default(ACTIVE)
  phoneVerifiedAt       DateTime?
  failedLogins          Int                   @default(0)
  lockedUntil           DateTime?
  lastLoginAt           DateTime?
  /// AES-256-GCM encrypted base32 TOTP secret
  totpSecret            String?
  totpEnabled           Boolean               @default(false)
  /// Last accepted TOTP time step, blocks code replay
  totpLastStep          Int?
  termsVersion          String?
  termsAcceptedAt       DateTime?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  stores                Store[]
  sessions              Session[]
  reports               Report[]              @relation("ReportedBy")
  auditLogs             AuditLog[]
  reviewedVerifications VerificationRequest[] @relation("VerificationReviewer")
  storeContacts         StoreContact[]        @relation("BuyerContacts")
  orders                Order[]               @relation("BuyerOrders")
  reviews               Review[]              @relation("BuyerReviews")
  moderatedReviews      Review[]              @relation("ReviewModerator")
  /// Reporter credibility: reports moderators confirmed or dismissed
  reportsConfirmed      Int                   @default(0)
  reportsDismissed      Int                   @default(0)
  /// Set after persistent false reporting; the account can't report until then
  reportingBlockedUntil DateTime?
  /// Per-category channel choices: { FOLLOWING: { inApp: true, push: false }, ... }; missing keys use defaults
  notificationPrefs     Json?
  notifications         Notification[]
  pushSubscriptions     PushSubscription[]
  favorites             Favorite[]
  follows               StoreFollow[]
  campaigns             Campaign[]            @relation("CampaignAuthor")
}

/// One refresh-token session per signed-in device and interface
model Session {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// web | merchant | admin
  audience     String
  tokenHash    String    @unique
  /// Rotated sessions share a family so token reuse can revoke all of them
  familyId     String
  mfa          Boolean   @default(false)
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?
  ip           String?
  userAgent    String?
  createdAt    DateTime  @default(now())

  @@index([userId])
  @@index([familyId])
}

model OtpCode {
  id         String     @id @default(cuid())
  phone      String
  purpose    OtpPurpose
  codeHash   String
  attempts   Int        @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  ip         String?
  createdAt  DateTime   @default(now())

  @@index([phone, purpose, createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String?
  meta       Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@index([createdAt])
}

model Governorate {
  id        String             @id @default(cuid())
  slug      String             @unique
  name      String             @unique
  sortOrder Int                @default(0)
  latitude  Float?
  longitude Float?
  /// Pilot rollout: stores open governorate by governorate
  status    GovernorateStatus  @default(COMING_SOON)
  markets   Market[]
  stores    Store[]
  interests MerchantInterest[]
  banners   HomeBanner[]
  orders    Order[]
}

model Market {
  id             String         @id @default(cuid())
  slug           String         @unique
  name           String
  description    String?
  sortOrder      Int            @default(0)
  /// Hidden from lists and registration without touching its stores
  isActive       Boolean        @default(true)
  /// Geofence centre and radius
  latitude       Float?
  longitude      Float?
  radiusMeters   Int?
  geofenceStatus GeofenceStatus @default(DRAFT)
  governorateId  String
  governorate    Governorate    @relation(fields: [governorateId], references: [id])
  stores         Store[]

  @@unique([governorateId, name])
}

model Category {
  id        String             @id @default(cuid())
  slug      String             @unique
  name      String             @unique
  icon      String
  sortOrder Int                @default(0)
  /// Hidden from lists and new listings; existing products keep it
  isActive  Boolean            @default(true)
  products  Product[]
  stores    Store[]
  interests MerchantInterest[]
}

/// Merchants who want to join from a governorate that hasn't opened yet
model MerchantInterest {
  id            String      @id @default(cuid())
  governorateId String
  governorate   Governorate @relation(fields: [governorateId], references: [id], onDelete: Cascade)
  name          String
  /// E.164 without the plus sign; not verified by SMS
  phone         String
  storeName     String?
  categoryId    String?
  category      Category?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  contactedAt   DateTime?
  createdAt     DateTime    @default(now())

  @@unique([governorateId, phone])
  @@index([governorateId, createdAt])
}

model Store {
  id                    String                @id @default(cuid())
  slug                  String                @unique
  name                  String
  tagline               String?
  description           String?
  ownerId               String
  owner                 User                  @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  governorateId         String
  governorate           Governorate           @relation(fields: [governorateId], references: [id])
  marketId              String?
  market                Market?               @relation(fields: [marketId], references: [id])
  categoryId            String?
  category              Category?             @relation(fields: [categoryId], references: [id])
  address               String?
  mapUrl                String?
  /// WhatsApp number, E.164 without plus
  whatsapp              String
  phone                 String?
  openingHours          String?
  /// Weekly hours in Damascus time: { days: [{ closed, open: "09:00", close: "20:00" }] }, index 0 = Sunday
  openingSchedule       Json?
  /// Shop position for maps; set by the merchant or from an approved shop-verification video
  latitude              Float?
  longitude             Float?
  logoUrl               String?
  coverUrl              String?
  hasDelivery           Boolean               @default(false)
  /// Public level: what buyers see, what ranks the store and which limits apply
  verificationLevel     VerificationLevel     @default(REGISTERED)
  /// Average of published reviews (one decimal) and their number, kept in sync by the reviews service
  ratingAvg             Float                 @default(0)
  ratingCount           Int                   @default(0)
  /// Highest level earned; differs from verificationLevel while the badge is suspended
  earnedLevel           VerificationLevel     @default(REGISTERED)
  /// Shop verification (LOCATION and above) expires and must be renewed yearly
  verificationExpiresAt DateTime?
  /// Set after repeated confirmed reports; the badge stays hidden until an admin restores it
  badgeSuspendedAt      DateTime?
  badgeRestoredAt       DateTime?
  /// When the merchant declared the store information true
  attestedAt            DateTime?
  status                StoreStatus           @default(ACTIVE)
  /// Normalized Arabic text used for search
  searchText            String                @default("")
  viewsCount            Int                   @default(0)
  contactsCount         Int                   @default(0)
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  orders                Order[]
  promotions            StorePromotion[]
  products              Product[]
  dailyStats            StoreDailyStat[]
  reports               Report[]
  verificationRequests  VerificationRequest[]
  buyerContacts         StoreContact[]
  reviews               Review[]
  followers             StoreFollow[]

  @@index([status, governorateId, marketId])
  @@index([status, verificationLevel])
  @@index([categoryId])
}

/// A signed-in buyer's contact with a store from its page (WhatsApp or call); reviewing requires one
model StoreContact {
  id             String   @id @default(cuid())
  storeId        String
  store          Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  buyerId        String
  buyer          User     @relation("BuyerContacts", fields: [buyerId], references: [id], onDelete: Cascade)
  firstContactAt DateTime @default(now())
  lastContactAt  DateTime @default(now())
  contacts       Int      @default(1)

  @@unique([storeId, buyerId])
  @@index([buyerId])
}

/// A purchase order a buyer sends to a shop: its lines, address, payment and the price agreed
model Order {
  id            String        @id @default(cuid())
  /// Short number both sides can quote, e.g. 1043
  ref           Int           @unique @default(autoincrement())
  storeId       String
  store         Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  buyerId       String?
  buyer         User?         @relation("BuyerOrders", fields: [buyerId], references: [id], onDelete: SetNull)
  items         OrderItem[]
  /// Copied when the order is placed, so it survives edits to the account
  buyerName     String
  buyerPhone    String
  currency      Currency      @default(SYP)
  /// Sum of the lines, before any delivery fee; null when a line is priced on request
  total         Int?
  fulfillment   Fulfillment   @default(DELIVERY)
  governorateId String?
  governorate   Governorate?  @relation(fields: [governorateId], references: [id])
  address       String?
  payment       PaymentMethod @default(CASH_ON_DELIVERY)
  note          String?
  status        OrderStatus   @default(NEW)
  /// What the shop answered: delivery fee and when it arrives
  deliveryFee   Int?
  merchantNote  String?
  cancelReason  String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  confirmedAt   DateTime?
  closedAt      DateTime?

  @@index([storeId, status, createdAt])
  @@index([buyerId, createdAt])
}

/// One line of an order; the title and price are copied so the order reads the same later
model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  title     String
  image     String?
  unitPrice Int?
  quantity  Int      @default(1)
  /// unitPrice × quantity
  lineTotal Int?

  @@index([orderId])
}

/// One review per buyer per store; only published reviews count towards the store rating
model Review {
  id                String       @id @default(cuid())
  storeId           String
  store             Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  buyerId           String
  buyer             User         @relation("BuyerReviews", fields: [buyerId], references: [id], onDelete: Cascade)
  rating            Int
  comment           String?
  status            ReviewStatus @default(PUBLISHED)
  /// Why the review is held or hidden (automatic check or moderator note); never shown publicly
  moderationNote    String?
  merchantReply     String?
  merchantRepliedAt DateTime?
  /// The merchant asked moderators to look at this review; it stays public meanwhile
  flagOpen          Boolean      @default(false)
  flagReason        String?
  flaggedAt         DateTime?
  moderatedById     String?
  moderatedBy       User?        @relation("ReviewModerator", fields: [moderatedById], references: [id], onDelete: SetNull)
  moderatedAt       DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@unique([storeId, buyerId])
  @@index([storeId, status, createdAt])
  @@index([status, createdAt])
}

/// Evidence a merchant submits to reach the next verification level
model VerificationRequest {
  id             String             @id @default(cuid())
  storeId        String
  store          Store              @relation(fields: [storeId], references: [id], onDelete: Cascade)
  kind           VerificationKind
  status         VerificationStatus @default(PENDING)
  /// Encrypted objects in the private bucket, by slot: { idFront: { key, type, size }, ... }
  files          Json
  latitude       Float?
  longitude      Float?
  accuracyMeters Float?
  /// When the shop video started recording, as reported by the phone
  capturedAt     DateTime?
  geoCheck       GeoCheck?
  distanceMeters Int?
  rejectReason   String?
  reviewerId     String?
  reviewer       User?              @relation("VerificationReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  reviewedAt     DateTime?
  /// Files of rejected requests are deleted after the retention period
  purgedAt       DateTime?
  createdAt      DateTime           @default(now())

  @@index([status, kind, createdAt])
  @@index([storeId, createdAt])
}

model Product {
  id            String        @id @default(cuid())
  storeId       String
  store         Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  categoryId    String
  category      Category      @relation(fields: [categoryId], references: [id])
  title         String
  description   String?
  priceType     PriceType     @default(FIXED)
  price         Int?
  oldPrice      Int?
  currency      Currency      @default(SYP)
  condition     ItemCondition @default(NEW)
  inStock       Boolean       @default(true)
  images        String[]
  status        ProductStatus @default(ACTIVE)
  riskScore     Int           @default(0)
  isFeatured    Boolean       @default(false)
  searchText    String        @default("")
  /// Meaning vector for semantic search (float32), and the model + text it was computed from
  embedding     Bytes?
  embeddingSig  String?
  viewsCount    Int           @default(0)
  contactsCount Int           @default(0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  orderItems    OrderItem[]
  reports       Report[]
  favoritedBy   Favorite[]

  @@index([status, categoryId])
  @@index([storeId, status])
  @@index([createdAt])
}

/// Per-store daily counters that power the merchant dashboard
model StoreDailyStat {
  id       String   @id @default(cuid())
  storeId  String
  store    Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  day      DateTime @db.Date
  views    Int      @default(0)
  whatsapp Int      @default(0)
  calls    Int      @default(0)

  @@unique([storeId, day])
}

model Report {
  id         String       @id @default(cuid())
  reporterId String
  reporter   User         @relation("ReportedBy", fields: [reporterId], references: [id], onDelete: Cascade)
  storeId    String?
  store      Store?       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  productId  String?
  product    Product?     @relation(fields: [productId], references: [id], onDelete: Cascade)
  reason     String
  details    String?
  status     ReportStatus @default(OPEN)
  createdAt  DateTime     @default(now())

  @@index([status, createdAt])
  @@index([reporterId, createdAt])
}

/// A buyer's saved product, kept on the server so price drops and restocks can be announced
model Favorite {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, productId])
  @@index([productId])
}

/// A buyer following a store to hear about its new products and offers
model StoreFollow {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, storeId])
  @@index([storeId])
}

/// In-app notification; also the record that decides whether a push was sent
model Notification {
  id         String               @id @default(cuid())
  userId     String
  user       User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  category   NotificationCategory
  /// Machine-readable event, e.g. verification.approved or product.price_drop
  type       String
  title      String
  body       String
  /// Path inside the recipient's interface, e.g. /dashboard/verification
  url        String?
  /// Related events share a key: an unread notification with the same key is updated instead of repeated
  groupKey   String?
  count      Int                  @default(1)
  readAt     DateTime?
  /// Hidden from the list (the in-app channel is off for this category) but kept for push limits and dedupe
  silent     Boolean              @default(false)
  pushedAt   DateTime?
  campaignId String?
  campaign   Campaign?            @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  @@index([userId, silent, createdAt])
  @@index([userId, readAt])
  @@index([userId, groupKey])
  @@index([userId, pushedAt])
}

/// A browser or phone that accepted push notifications for one interface
model PushSubscription {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// web | merchant | admin: pushes only go to the interface the recipient signs in to
  audience      String
  endpoint      String    @unique
  p256dh        String
  auth          String
  userAgent     String?
  failures      Int       @default(0)
  lastSuccessAt DateTime?
  createdAt     DateTime  @default(now())

  @@index([userId, audience])
}

/// A notification an admin sends to many users (news, offers, invitations)
model Campaign {
  id            String               @id @default(cuid())
  category      NotificationCategory
  audience      CampaignAudience
  title         String
  body          String
  url           String?
  status        CampaignStatus       @default(SENDING)
  recipients    Int                  @default(0)
  delivered     Int                  @default(0)
  pushed        Int                  @default(0)
  createdById   String?
  createdBy     User?                @relation("CampaignAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime             @default(now())
  finishedAt    DateTime?
  notifications Notification[]

  @@index([createdAt])
}

/// Promo banner on the buyer homepage, managed by the platform team
model HomeBanner {
  id            String       @id @default(cuid())
  eyebrow       String
  title         String
  cta           String
  /// A path inside the buyer site only
  href          String
  imageUrl      String?
  tone          String       @default("brand")
  /// null = every governorate
  governorateId String?
  governorate   Governorate? @relation(fields: [governorateId], references: [id], onDelete: Cascade)
  startsAt      DateTime?
  endsAt        DateTime?
  sortOrder     Int          @default(0)
  isActive      Boolean      @default(true)
  clicks        Int          @default(0)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([isActive, sortOrder])
}

/// A store that bought a visibility package: shown by name in the homepage showcase
model StorePromotion {
  id        String    @id @default(cuid())
  storeId   String
  store     Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  /// The package the store bought, e.g. "باقة الواجهة"
  plan      String
  startsAt  DateTime?
  endsAt    DateTime?
  sortOrder Int       @default(0)
  isActive  Boolean   @default(true)
  clicks    Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([isActive, sortOrder])
  @@index([storeId])
}

/// Small server-generated settings, e.g. the Web Push VAPID key pair (private key encrypted)
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
